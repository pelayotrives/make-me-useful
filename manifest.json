{
  "manifest_version": 3,
  "name": "Make me useful",
  "version": "0.1.2",
  "description": "Chain focused study timers, protect your attention, and take deliberate breaks.",
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Make me useful",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "permissions": [
    "alarms",
    "declarativeNetRequest",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
